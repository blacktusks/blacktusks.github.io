{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2021", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "isolatedModules": true, "allowSyntheticDefaultImports": true, "esModuleInterop": true, "noUnusedLocals": true,
    "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "vite.config.ts"]
}
