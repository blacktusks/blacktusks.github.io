# Copy to .env.local for development, or .env.production for the published site.
# Both values come from Supabase > Project Settings > API. They are public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional. Must match LOGIN_EMAIL_DOMAIN in the clan-api function secrets.
# VITE_LOGIN_EMAIL_DOMAIN=blacktusk.invalid
